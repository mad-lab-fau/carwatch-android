<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="@dimen/swipe_button_height"
        android:layout_marginHorizontal="@dimen/swipe_widget_padding"
        android:background="@drawable/shape_rounded"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_slide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/swipe_widget_padding"
        android:background="@drawable/shape_button"
        android:contentDescription="@string/stop"
        android:elevation="8dp"
        android:padding="@dimen/swipe_button_padding"
        android:src="@drawable/ic_ring_black_24dp"
        app:layout_constraintBottom_toBottomOf="@id/container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/container" />

    <TextView
        android:id="@+id/tv_stop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/swipe_widget_padding"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="end|center_vertical"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:padding="16dp"
        android:text="@string/stop"
        android:textAllCaps="true"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="@id/container"
        app:layout_constraintEnd_toEndOf="@id/container"
        app:layout_constraintStart_toEndOf="@id/iv_slide"
        app:layout_constraintTop_toTopOf="@id/container" />

</androidx.constraintlayout.widget.ConstraintLayout>
