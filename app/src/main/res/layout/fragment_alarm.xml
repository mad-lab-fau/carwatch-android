<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_app_surface"
        android:fillViewport="true"
        tools:context=".ui.MainActivity">

        <LinearLayout
            android:id="@+id/alarm_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="@dimen/primary_screen_bottom_padding">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/alarm_primary_card"
                android:layout_width="match_parent"
                android:layout_height="@dimen/primary_card_height"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardElevation="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Carwatch.Card"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/alarm_primary_card_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="24dp">

                    <FrameLayout
                        android:id="@+id/alarm_primary_icon_badge"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:id="@+id/iv_alarm"
                            android:layout_width="@dimen/home_icon_size"
                            android:layout_height="@dimen/home_icon_size"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_alarm_black_24dp"
                            app:tint="?attr/colorOnPrimaryContainer" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_alarm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/set_alarm_message"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextAppearance.Carwatch.Headline"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/alarm_primary_time_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                        app:cardElevation="0dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Carwatch.Card"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:id="@+id/alarm_primary_time_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="88dp"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/alarm_active_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/alarm_time_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textAlignment="viewEnd"
                                android:textAppearance="@style/TextAppearance.Carwatch.DisplayTime"
                                android:textColor="?attr/colorOnSurface" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:id="@+id/alarm_separator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:weightSum="1">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="0.8"
                            android:background="?attr/colorOutlineVariant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/saliva_alarms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_saliva_alarms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/saliva_alarms_header"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/saliva_alarms_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:fadeScrollbars="false"
                    android:nestedScrollingEnabled="false"
                    android:scrollbarStyle="outsideInset"
                    android:scrollbars="vertical"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_alarm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/evening_sample_alarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_evening_sample_alarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/evening_sample_alarm_header"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/evening_sample_alarm_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:fadeScrollbars="false"
                    android:nestedScrollingEnabled="false"
                    android:scrollbarStyle="outsideInset"
                    android:scrollbars="vertical"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_alarm" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <data>

        <variable
            name="viewmodel"
            type="de.fau.cs.mad.carwatch.ui.alarm.AlarmViewModel" />
    </data>
</layout>
